# bin/setup generates .env with independent random passwords.
# Host ports are local to School Control: Rails inside Docker still listens on 3000.
# sale_point uses host 3000, 5432 and 6379; School Control keeps those separate.
SCHOOL_BACKEND_PORT=3200
SCHOOL_FRONTEND_PORT=5173
DB_PASSWORD=replace-with-a-long-random-password
ADMIN_EMAIL=admin@school.test
ADMIN_PASSWORD=replace-with-at-least-12-characters
DEMO_SEEDS=true
DEMO_PASSWORD=replace-with-at-least-12-characters
SCHOOL_NAME=Primaria Aula
# Production only:
# SECRET_KEY_BASE=generate-with-openssl-rand-hex-64
# DATABASE_URL=postgresql://school:password@db:5432/school_production
# Email stays disabled in production until configured. Development uses Letter Opener.
# ENABLE_EMAIL_DELIVERY=true
# MAIL_FROM=avisos@your-school.example
# PORTAL_URL=https://your-school.example
# SMTP_ADDRESS=smtp.example
# SMTP_PORT=587
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
